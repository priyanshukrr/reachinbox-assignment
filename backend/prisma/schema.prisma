generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  googleId  String?  @unique
  username  String?  @unique
  password  String?
  name      String
  email     String   @unique
  avatar    String?
  role      String   @default("USER")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campaigns Campaign[]
  emails    Email[]

  @@index([email])
  @@index([username])
}

model Campaign {
  id                 String   @id @default(uuid())
  userId             String
  subject            String
  body               String   @db.Text
  startTime          DateTime
  delayBetweenEmails Int
  hourlyLimit        Int
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  emails Email[]

  @@index([userId])
  @@index([startTime])
}

model Email {
  id         String   @id @default(uuid())
  userId     String
  campaignId String

  recipient String
  subject   String
  body      String   @db.Text

  scheduledAt DateTime
  sentAt      DateTime?

  status    EmailStatus @default(SCHEDULED)
  attempts  Int         @default(0)
  messageId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([campaignId])
  @@index([scheduledAt])
  @@index([status])
  @@index([recipient])
  @@index([campaignId, status, scheduledAt])
}

enum EmailStatus {
  SCHEDULED
  PROCESSING
  SENT
  FAILED
}